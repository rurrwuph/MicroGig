{
  "info": {
    "name": "MicroGig API",
    "description": "Postman Collection for testing all MicroGig APIs (Auth, Work Requests, and Assignments).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_client\",\n  \"email\": \"client@postman.com\",\n  \"role\": \"client\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            }
          }
        },
        {
          "name": "Register Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_freelancer\",\n  \"email\": \"freelancer@postman.com\",\n  \"role\": \"freelancer\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            }
          }
        },
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"client_token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_client\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            }
          }
        },
        {
          "name": "Login Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"freelancer_token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_freelancer\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Work Requests",
      "item": [
        {
          "name": "Create Work Request (Client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman API Integration\",\n  \"description\": \"I need a developer to integrate the Postman APIs into my backend.\",\n  \"amount\": 300.00,\n  \"deadline\": \"2026-12-31T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work"
              ]
            }
          }
        },
        {
          "name": "Get All Work Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/work",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Work Assignments (Freelancer Flow)",
      "item": [
        {
          "name": "Accept Work (Freelancer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/1/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "1",
                "accept"
              ]
            }
          }
        },
        {
          "name": "Submit Work (Freelancer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/1/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "1",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Pay for Work (Client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/1/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "1",
                "pay"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "client_token",
      "value": ""
    },
    {
      "key": "freelancer_token",
      "value": ""
    }
  ]
}
